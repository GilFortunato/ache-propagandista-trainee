# Exclusivo para o projeto Aché; configure os valores reais como segredos na Vercel.
# Integração de pesquisa: Manus API v2. Apify não é mais usado no ReBrand.
ACHE_REBRAND_MANUS_API_KEY=
ACHE_REBRAND_GEMINI_API_KEY=
ACHE_REBRAND_GEMINI_MODEL=gemini-2.5-flash

# Google OAuth Web Client (Google Cloud Console).
# Redirect URI autorizada: https://ache-propagandista-trainee.vercel.app/api/auth/google/callback
ACHE_GOOGLE_CLIENT_ID=
ACHE_GOOGLE_CLIENT_SECRET=
ACHE_GOOGLE_REDIRECT_URI=https://ache-propagandista-trainee.vercel.app/api/auth/google/callback
ACHE_PUBLIC_URL=https://ache-propagandista-trainee.vercel.app
ACHE_AUTH_SESSION_SECRET=
# Conta Google da proprietária, sem limite de pesquisas. Conferida somente após OAuth verificado.
ACHE_OWNER_GOOGLE_EMAIL=

# Banco Neon Postgres exclusivo do Aché, necessário para cotas e tarefas.
# Criar no Storage/Marketplace da Vercel e executar database/ache_rebrand_manus.sql.
ACHE_REBRAND_DATABASE_URL=

# Área administrativa; somente credenciais criptografadas no servidor.
ACHE_ADMIN_PASSWORD_HASH=
ACHE_ADMIN_SESSION_SECRET=
ACHE_VERCEL_API_TOKEN=
ACHE_VERCEL_PROJECT_ID=
ACHE_VERCEL_TEAM_ID=
