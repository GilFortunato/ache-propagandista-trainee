# Integrações exclusivas do ReBrand Pessoal / Aché Experience
# NÃO reutilizar as credenciais do projeto Diagnóstico Comercial.
ACHE_REBRAND_GEMINI_API_KEY=""
ACHE_REBRAND_GEMINI_MODEL="gemini-3.8-flash"
ACHE_REBRAND_APIFY_TOKEN=""
ACHE_REBRAND_APIFY_LINKEDIN_ACTOR_ID="unseenuser/linkedin-profile"

# Coleta opcional de publicações (pode gerar custo adicional no Apify).
# Ative somente quando autenticação e limites de utilização estiverem configurados.
ACHE_REBRAND_ENABLE_POSTS=false
ACHE_REBRAND_APIFY_POSTS_ACTOR_ID=harvestapi/linkedin-profile-posts

# ADMIN SEGURO (não incluir segredos no GitHub)
# Hash scrypt da senha ADM, definido como variável criptografada na Vercel.
ACHE_ADMIN_PASSWORD_HASH=
# Segredo randômico de pelo menos 32 caracteres para sessões HttpOnly.
ACHE_ADMIN_SESSION_SECRET=

# Opcionais: armazenamento gerenciado diretamente pela API Vercel.
# Configure um token de acesso Vercel com a menor abrangência de permissões possível.
# NUNCA use NEXT_PUBLIC_* para estas variáveis.
ACHE_VERCEL_API_TOKEN=
ACHE_VERCEL_PROJECT_ID=
ACHE_VERCEL_TEAM_ID=

# Chaves do Apify e do Gemini podem ser criadas e rotacionadas pelo painel ADM
# depois de configurar ACHE_VERCEL_API_TOKEN uma única vez.
# Até que o login real de participantes esteja disponível, a rota de
# diagnóstico com serviços pagos aceita somente sessão administrativa.
